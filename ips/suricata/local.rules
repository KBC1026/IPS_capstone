drop icmp any any -> any any (msg:"LAB ICMP Ping Detected"; sid:1000001; rev:1;)

alert tcp any any -> 192.168.2.100 any (msg:"LAB Port scan detected"; flags:S; detection_filter:track by_src, count 3, seconds 10; classtype:attempted-recon; sid:1000002; rev:2;)

alert http any any -> 192.168.2.100 5000 (msg:"LAB WEB brute force detected"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/login"; detection_filter:track by_src, count 2, seconds 10; classtype:web-application-attack; sid:1000003; rev:3;)

