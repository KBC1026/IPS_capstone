drop http any any -> 192.168.2.100 5000 (msg:"LAB SQL Injection detected"; flow:established,to_server; http.uri; content:"/login"; pcre:"/(%27|'|%22|\")\s*(or|OR)\s*(%27|'|%22|\")?[0-9a-zA-Z_]+\s*(=|%3d)\s*(%27|'|%22|\")?[0-9a-zA-Z_]+/i"; classtype:web-application-attack; sid:1000005; rev:2;)

drop http any any -> 192.168.2.100 5000 (msg:"LAB SQL Injection detected"; flow:established,to_server; http.uri; content:"/login"; http.request_body; pcre:"/(%27|'|%22|\")\s*(or|OR)\s*(%27|'|%22|\")?[0-9a-zA-Z_]+\s*(=|%3d)\s*(%27|'|%22|\")?[0-9a-zA-Z_]+/i"; classtype:web-application-attack; sid:1000006; rev:2;)

drop http any any -> 192.168.2.100 5000 (msg:"LAB SQL Injection detected"; flow:established,to_server; http.uri; content:"/login"; http.request_body; pcre:"/(union\s+select|--|%2d%2d|#|%23|\/\*|drop\s+table)/i"; threshold:type limit, track by_src, count 3, seconds 60; classtype:web-application-attack; sid:1000007; rev:2;)

