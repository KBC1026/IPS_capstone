FLASK_ENV=production
API_BIND_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=https://chanxai.com,http://localhost:5173

WAZUH_URL=https://127.0.0.1
WAZUH_API_PORT=55000
WAZUH_USER=admin
WAZUH_PASSWORD=change-me
WAZUH_VERIFY_SSL=false

# Optional. Recommended for alert/event search because Wazuh alerts live in the indexer.
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=change-me
WAZUH_INDEXER_VERIFY_SSL=false
WAZUH_ALERT_INDEX=wazuh-alerts-*
WAZUH_ALERT_TIME_RANGE=now-24h
WAZUH_DEFAULT_LAB_ONLY=true
# Keep false in production so broken Wazuh/Indexer connections do not masquerade as real logs.
WAZUH_DEMO_FALLBACK=false

KALI_HOST=100.0.0.10
KALI_PORT=22
KALI_USER=kali
KALI_PASSWORD=
KALI_KEY_FILE=/opt/chanxai-api/keys/kali_id_rsa
KALI_COMMAND_TIMEOUT=120
KALI_PORTSCAN_COMMAND=/home/kali/IPS_capstone/kali/port_scan_blocked.py
KALI_BRUTEFORCE_COMMAND=/home/kali/IPS_capstone/kali/brute_force_blocked.py
KALI_SQLI_COMMAND=/home/kali/IPS_capstone/kali/sql_injection_blocked.py
